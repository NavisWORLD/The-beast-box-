{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://navisworld.invalid/soul-qbt-final-kit/run.schema.json",
  "title": "SOUL QBT final kit run manifest",
  "type": "object",
  "required": ["schema", "run_id", "kit_version", "seed", "prompt_sha256", "source_record_ids", "conditions", "metrics_frozen_before_execution", "official_beast_classification", "sealed_scientific_anchor"],
  "properties": {
    "schema": {"const": "soul-qbt-final-kit-run-v1"},
    "run_id": {"type": "string"},
    "kit_version": {"const": "1.0.0"},
    "seed": {"type": "integer"},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_record_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "conditions": {"const": ["A", "B", "C", "D"]},
    "neutral_qbt_vector": {"const": [0.5, 0.5, 0.5, 0.5]},
    "provider_mode": {"enum": ["reference", "ollama"]}
  }
}
