# Example variable NAMES only. Do not put real credentials in the repository.
# IBM_QUANTUM_TOKEN is consumed by an isolated broker, never by the creature/model process.
IBM_QUANTUM_TOKEN=
# Azure credentials belong in the owner-controlled Azure broker/service environment.
AZURE_CREATURE_ENDPOINT=
AZURE_CREATURE_AUTH_REFERENCE=
# Hugging Face credentials, when needed for gated model acquisition, belong in an isolated fetch job.
HF_TOKEN=
