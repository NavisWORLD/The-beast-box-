# Local Beast runtime. These values are examples only.
BEASTBOX_MODEL_NAME=my-model
BEASTBOX_MODEL_URL=http://127.0.0.1:11434
BEASTBOX_QUANTUM_HEART_MODE=off

# Optional host-side IBM Quantum broker only.
# Never place real credentials in state capsules, model prompts, logs,
# committed .env files, or the contained box.
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_INSTANCE=
