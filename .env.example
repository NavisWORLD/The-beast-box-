# Beast Box environment contract
#
# Copy this file only when environment configuration is useful for your setup.
# Every value is intentionally empty/safe. Never commit real credentials.
# CI inventories fixed-name reads in the supported beastbox package and fails if
# a fixed variable is used without being represented here.
#
# Compatible-provider profiles may deliberately reference a user-selected secret
# variable by NAME (api_key_env). Those names are reported separately by CI as
# secret-reference-v1 contracts because they are not fixed Beast configuration.

# -----------------------------------------------------------------------------
# LOCAL / REFERENCE RUNTIME
# -----------------------------------------------------------------------------

# Optional. Model display/name used by supported local runtime surfaces.
# Default: subsystem-specific local/reference default. Sensitive: no.
# Preserved compatibility variable; some packaged/config surfaces may use it
# even when the current first-party Python package does not read it directly.
BEASTBOX_MODEL_NAME=

# Optional. Local model/provider URL where supported.
# Default: subsystem-specific loopback URL. Sensitive: no.
# Preserved compatibility variable for existing launch/config surfaces.
BEASTBOX_MODEL_URL=

# Optional. Selects the supported quantum-heart mode where that adapter is used.
# Default: deterministic/local behavior. Sensitive: no.
# Preserved compatibility variable for existing launch/config surfaces.
BEASTBOX_QUANTUM_HEART_MODE=

# Optional. Path-separated workspace roots exposed read-only to COSMIC workspace
# tools. Default: no configured workspace roots. Sensitive: path metadata only;
# never grants write/shell authority.
BEASTBOX_WORKSPACE_ROOTS=

# Optional. Passphrase for AES-256-GCM idle-store and v2 portable sealing.
# Default: unset; the working SQLite file remains local 0600 plaintext.
# Sensitive: YES. Never commit a real value. Minimum 8 characters when set.
# Requires cosmos-beast-box[secure]. Authority and host credentials still
# do not travel with sealed snapshots.
BEASTBOX_SEAL_PASSPHRASE=

# Optional. Overrides the COSMIC.CYPHER local registry home directory.
# Default: ~/.cosmic-cypher. Sensitive: local path metadata only.
# The model registry remains local; setting this does not grant model authority.
COSMIC_CYPHER_HOME=

# -----------------------------------------------------------------------------
# ZEREF LOCAL PROFILE / OLLAMA FRONT DOOR
# -----------------------------------------------------------------------------

# Optional. Overrides Zeref's local runtime/config home.
# Default: ~/.cosmos-zeref. Sensitive: local path metadata only.
ZEREF_HOME=

# Optional. Base Ollama/Hugging Face model reference used when constructing the
# local Zeref profile. Default: hf.co/phera-ra/QC67_cosmo. Sensitive: no.
ZEREF_BASE_MODEL=

# Optional. Ollama profile/model name used for the local Zeref profile.
# Default: zeref. Sensitive: no.
ZEREF_OLLAMA_PROFILE=

# -----------------------------------------------------------------------------
# CI / PROVENANCE METADATA
# -----------------------------------------------------------------------------

# Optional. Git commit identity injected automatically by GitHub Actions and read
# by supported provenance/receipt surfaces when present.
# Default outside GitHub Actions: unset. Sensitive: no. Do not hand-author it to
# impersonate a different execution revision.
GITHUB_SHA=

# -----------------------------------------------------------------------------
# OPTIONAL IBM QUANTUM ADAPTER
# -----------------------------------------------------------------------------
# These are required only for an explicitly authorized live IBM probe. They are
# never required for the deterministic reference path.

# Optional/live-only. IBM Quantum token. Sensitive: YES.
IBM_QUANTUM_TOKEN=

# Optional/live-only. IBM Quantum instance/account selector. Sensitive: account metadata.
IBM_QUANTUM_INSTANCE=

# Optional/live-only. Explicit IBM backend name. Sensitive: no.
IBM_QUANTUM_BACKEND=

# -----------------------------------------------------------------------------
# OPTIONAL AZURE QUANTUM ADAPTER
# -----------------------------------------------------------------------------
# Required only for the explicitly authorized Azure Quantum probe.

# Optional/live-only. Azure Quantum resource identifier. Sensitive: account/resource metadata.
AZURE_QUANTUM_RESOURCE_ID=

# Optional/live-only. Azure Quantum region/location. Sensitive: no.
AZURE_QUANTUM_LOCATION=

# Optional/live-only. Bounded target name; the current probe accepts ionq.simulator.
# Sensitive: no.
AZURE_QUANTUM_TARGET=

# Experimental Stage 012: Azure-hosted Rigetti FREE QVM only.
# Supply this as a GitHub Actions secret, NOT a repository file or chat message.
# Entire Quantum-workspace connection string, NOT a raw key or Blob string.
# When present, the alternative four workspace identifiers are not required.
# Default: unset. Sensitive: YES.
AZURE_QUANTUM_CONNECTION_STRING=

# Alternative Azure identity workspace selection; NOT needed when the Quantum
# connection string above is supplied. Restrict identity to the single Quantum
# workspace and use role "Quantum Workspace Data Contributor" where possible.
AZURE_QUANTUM_SUBSCRIPTION_ID=
AZURE_QUANTUM_RESOURCE_GROUP=
AZURE_QUANTUM_WORKSPACE_NAME=

# Opt-in free Rigetti simulator: BOTH this and an exact allowed target are
# required for an actual provider job. All other targets fail closed.
AZURE_QUANTUM_QVM_OPT_IN=
COSMOS_APPROVED_QVM_TARGET=

# -----------------------------------------------------------------------------
# HOST CREDENTIALS SCANNED FOR PORTABLE-STATE EXCLUSION
# -----------------------------------------------------------------------------
# The variables below are NOT restored into a Beast and are NOT transferred with
# portable state. If present on the host, their values are checked so an export
# containing a configured credential is refused. Empty is the normal/default
# value for Beast Box itself.

# Optional host credential. Sensitive: YES. Portable-state denylist only.
QISKIT_IBM_TOKEN=

# Optional host credential. Sensitive: YES. Portable-state denylist only.
AZURE_CLIENT_SECRET=

# Optional host credential. Sensitive: YES. Portable-state denylist only.
AZURE_API_KEY=

# Optional host credential. Sensitive: YES. Portable-state denylist only.
AZURE_OPENAI_API_KEY=

# Optional host credential. Sensitive: YES. Portable-state denylist only.
OPENAI_API_KEY=

# Optional host credential. Sensitive: YES. Portable-state denylist only.
GITHUB_TOKEN=

# Optional host credential. Sensitive: YES. Portable-state denylist only.
GH_TOKEN=

# Optional host-only AES-256-GCM key for the separately hosted cloud BYOK vault.
# Exactly 32 random bytes, standard Base64 encoded; not a login password.
# Never commit a value, export it with user state, or reuse a session signing key.
# Requires cosmos-beast-box[secure] on the durable host. No cloud key storage
# operates if this variable is absent. Sensitive: YES.
BEASTBOX_CONNECTION_VAULT_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL OWNER-ONLY BIO INPUT GATES (off unless exactly "yes")
# -----------------------------------------------------------------------------
# Enable owner-consented numerical bio previews. Does not open a device or persist.
# Default: off. Sensitive: config only; numeric data sent to host remains sensitive.
BEASTBOX_BIO_INGEST_ENABLED=

# Separate durable persistence permission. Requires ingest enabled, per-request
# explicit consent, and the existing sensors authority. Default: off.
BEASTBOX_BIO_PERSIST_ENABLED=

# Separate permission to forward normalized bio features to a remote model.
# Also requires per-request remote_share_confirmed=true. Default: off.
BEASTBOX_BIO_REMOTE_ALLOWED=

# Optional. Verified 12K checkpoint directory on the private owner host. Default: absent.
RAWRPHOS_CHECKPOINT_PATH=
# Optional owner-only, unpromoted 18K checkpoint on a separate private port; never replaces 14K.
RAWRPHOS_18K_CHECKPOINT_PATH=

# Host-only RAWRPHØS loopback bearer key, at least 32 characters. NEVER publish.
RAWRPHOS_API_KEY=


# Public guest inference using the SAME existing Railway backend and pinned local
# 14K model. The Next.js guest form's Hugging Face BYOK uses the guest's own key.
# OFF by default. Set "yes" only after accepted staging and quotas.
BEASTBOX_GUEST_LOCAL_ENABLED=
# Conservative total host CPU admission caps. These are COUNTS, not USD spending.
BEASTBOX_GUEST_DAILY_MAX=
BEASTBOX_GUEST_PER_CLIENT_DAILY_MAX=
BEASTBOX_GUEST_TOTAL_MAX=


# Isolated owner-only CNS7 -> pinned RAWRPHOS native model probe. OFF by
# default; explicit consent and numerical-bound checks required per request.
# Does not enable automatic real bio retention, quantum jobs or guest tools.
BEASTBOX_CNS_MODEL_PROBE_ENABLED=

# Owner-only typed sensory + replayed quantum-derived -> CNS7 -> RAWRPHOS
# native multi-arm probe. OFF by default. Uses only existing archive summaries;
# does not launch IBM/Azure jobs, persist readings, train weights, or grant tools.
BEASTBOX_SIGNAL_MODEL_PROBE_ENABLED=

# One-shot read-only pinned 14K managed-host acceptance BEFORE enabling the
# owner-facing signal endpoint. Synthetic bio + published archive replay only.
# Default: off. Set to yes for a single deploy, then return to no.
BEASTBOX_SIGNAL_ACCEPTANCE_ON_START=
