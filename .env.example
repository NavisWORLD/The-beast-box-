# Local Beast runtime. Leave committed example values empty.
# See QUANTUM_BEAST_STARTER/README.md and config/beastbox.example.json for local examples.
BEASTBOX_MODEL_NAME=
BEASTBOX_MODEL_URL=
BEASTBOX_QUANTUM_HEART_MODE=

# Optional host-side IBM Quantum broker only.
# Never place real credentials in state capsules, model prompts, logs,
# committed .env files, or the contained box.
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_INSTANCE=
