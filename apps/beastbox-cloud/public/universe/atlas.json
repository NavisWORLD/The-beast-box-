 "rules": {
  "planet": {
   "key": "{biome}.v{variant}.{hab_stage}",
   "sheet": "planets_256 (planets_64 for small)",
   "biome": {
    "ember_world": "temperature_k>700 and water<0.6",
    "paper_sea": "temperature_k>700 and water>=0.6",
    "glacier": "temperature_k<240",
    "jelly_geyser": "240<=temperature_k<=700 and water>=0.6",
    "sunflower_ring": "240<=temperature_k<=700 and 0.3<=water<0.6",
    "crystal_moss": "240<=temperature_k<=700 and water<0.3"
   },
   "biome_order": "temperature first (>700 hot, <240 glacier), then water (>=0.6, 0.3-0.6, <0.3); Emeth bible cutoffs",
   "variant": "parseInt(sha256(seed+planet.id).slice(0,8),16) % 4 (any stable hash of id works)",
   "hab_stage": {
    "barren": [
     0,
     0.0001
    ],
    "waking": [
     0.0001,
     0.3
    ],
    "living": [
     0.3,
     1.01
    ]
   },
   "scale": "draw size px = clamp(18*sqrt(radius_earth),10,64) at map zoom",
   "sky_tint": "tint halo toward host star hue (bible: hue tints skies)",
   "name": "first planet ever to get a life entry is labelled \"Hearth\" (placeholder)",
   "hearth": {
    "key": "hearth.{waking|living}",
    "when": "home planet (first life world, or most habitable before life) AND biome==glacier; living if it has a life entry else waking",
    "note": "round glacier world, gold glowing from inside; fallback to glacier.v*.{stage} if home is not a glacier"
   }
  },
  "star": {
   "key": "{class}.lum{0-2}",
   "class": {
    "ember_star": [
     0,
     1
    ],
    "lantern_star": [
     1,
     8
    ],
    "storm_crowned": [
     8,
     999
    ]
   },
   "class_field": "mass_solar",
   "lum_stage": "log10(luminosity): <0 -> lum0, 0..2 -> lum1, >2 -> lum2",
   "tint": "multiply/hue-rotate frame by star.hue (frames drawn at hue 0 red); core colour can blend temp_rgb(temperature_k)",
   "remnant": {
    "neutron_star": "clenched_heart.f0-3 (spin loop)",
    "black_hole": "quiet_door.f0-3 (slow breathe, calm)"
   },
   "supernova": "play supernova.f0-3 once on the tick remnant first appears, then switch to remnant",
   "newborn": "newborn.f0-2 (no face) over a nebula for star births"
  },
  "storm": {
   "source": "universe.storms[] = {id,planet,intensity,lifetime,born}",
   "key": "storm.{phase}.v{variant}",
   "phase": "age=tick-born; p=age/max(lifetime,1); p<0.15 spawn, p>=0.75 fade, else peak; lifetime<=1 -> peak on born tick, fade on born+1 (engine keeps storm while born+lifetime>=tick)",
   "variant": "parseInt(sha256(storm.id).slice(0,8),16)%2 (any stable hash)",
   "intensity": "sprite alpha = 0.35+0.65*clamp(intensity/0.5,0,1); scale = planet size*(1.05+0.25*clamp(intensity/0.5,0,1)) (intensity = r*atmosphere, so <=1, typically small)",
   "attach": "centered on planet with id==storm.planet, drawn over the planet sprite"
  },
  "life": {
   "key": "{stage}.m{motility>=0.5}.s{sociality>=0.5}[.scar]",
   "stage": "life.stage.toLowerCase() (Glimmer|Drifters|Choirs|Dreamers); fallback: from life.complexity_norm with bands below; never from raw complexity",
   "stage_by_complexity_norm": {
    "glimmer": [
     0,
     0.3
    ],
    "drifters": [
     0.3,
     0.6
    ],
    "choirs": [
     0.6,
     0.9
    ],
    "dreamers": [
     0.9,
     99
    ]
   },
   "tint": "frames are white; tint with traits.hue (bioluminescence)",
   "diversity": "draw min(diversity,6) copies around the planet limb",
   "scar": "append .scar when life.scarred===true (scars>0); scars live on the creatures, not the land",
   "scar_count": "optional: life.scars>=3 -> also lower halo alpha 15% (art suggestion only)"
  },
  "thread": {
   "source": "universe.pairs[] = {a,b,E}; draw ONLY between planet a and planet b; never to stars, never to Zeref/his star",
   "key": "thread.e{tier}.f{0-3}",
   "tier": "tier=clamp(floor(|sim_E|*4),0,3) (E>=0.75 -> e3 brightest); extra: multiply alpha by clamp(|sim_E|,0.2,1)",
   "note": "engine currently gives every pair the same hardware E (0.97461), so all threads are e3; per-pair E would make brightness vary"
  },
  "comet": "comet.f0-3 ambient (engine has no comets; optional decoration, keep off if view must be engine-only)",
  "nebula": "nebula.v0-3 background, behind newborn stars"
 },
 "credit": "Sprites by Cosmo (v2)"
