 "rules": {
  "planet": {
   "key": "{biome}.v{variant}.{hab_stage}",
   "sheet": "planets_256 (planets_64 for small)",
   "biome": {
    "ember_world": "temperature_k>700 and water<0.6",
    "paper_sea": "temperature_k>700 and water>=0.6",
    "glacier": "temperature_k<240",
    "jelly_geyser": "240<=temperature_k<=700 and water>=0.6",
    "sunflower_ring": "240<=temperature_k<=700 and 0.3<=water<0.6",
    "crystal_moss": "240<=temperature_k<=700 and water<0.3"
   },
   "biome_order": "temperature first (>700 hot, <240 glacier), then water (>=0.6, 0.3-0.6, <0.3); Emeth bible cutoffs",
   "variant": "parseInt(sha256(seed+planet.id).slice(0,8),16) % 4 (any stable hash of id works)",
   "hab_stage": {
    "barren": [
     0,
     0.0001
    ],
    "waking": [
     0.0001,
     0.3
    ],
    "living": [
     0.3,
     1.01
    ]
   },
   "scale": "draw size px = clamp(18*sqrt(radius_earth),10,64) at map zoom",
   "sky_tint": "tint halo toward host star hue (bible: hue tints skies)",
   "name": "first planet ever to get a life entry is labelled \"Hearth\""
  },
  "star": {
   "key": "{class}.lum{0-2}",
   "class": {
    "ember_star": [
     0,
     1
    ],
    "lantern_star": [
     1,
     8
    ],
    "storm_crowned": [
     8,
     999
    ]
   },
   "class_field": "mass_solar",
   "lum_stage": "log10(luminosity): <0 -> lum0, 0..2 -> lum1, >2 -> lum2",
   "tint": "multiply/hue-rotate frame by star.hue (frames drawn at hue 0 red); core colour can blend temp_rgb(temperature_k)",
   "remnant": {
    "neutron_star": "clenched_heart.f0-3 (spin loop)",
    "black_hole": "quiet_door.f0-3 (slow breathe, calm)"
   },
   "supernova": "play supernova.f0-3 once on the tick remnant first appears, then switch to remnant",
   "newborn": "newborn.f0-2 (no face) over a nebula for star births"
  },
  "storm": {
   "key": "storm.{phase}.v{0-1}",
   "phase": "spawn first 15% of storm life, peak middle, fade last 25% (storm fields not in samples: storms[] empty at tick 0 and 200)",
   "attach": "centered on storm.planet, same scale as planet sprite"
  },
  "life": {
   "key": "{stage}.m{motility>=0.5}.s{sociality>=0.5}[.scar]",
   "stage_by_complexity": {
    "glimmer": [
     0,
     0.3
    ],
    "drifters": [
     0.3,
     0.6
    ],
    "choirs": [
     0.6,
     0.9
    ],
    "dreamers": [
     0.9,
     99
    ]
   },
   "complexity_note": "sample has complexity 4.33 (>1): if engine complexity is unbounded, normalise or Hearth is always Dreamers; confirm with Phera",
   "tint": "frames are white; tint with traits.hue (bioluminescence)",
   "diversity": "draw min(diversity,6) copies around the planet limb",
   "scar": "use .scar frames (scar on creatures) when life survived a storm (lore flag; not in JSON yet)"
  },
  "thread": "thread.f0-3 stretched between entangled planet pairs (pair field not in samples)",
  "comet": "comet.f0-3 ambient",
  "nebula": "nebula.v0-3 background, behind newborn stars"
 },
 "credit": "Sprites by Cosmo"
}