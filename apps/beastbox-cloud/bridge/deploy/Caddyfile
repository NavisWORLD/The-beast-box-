{
  admin off
  auto_https off
}
# Railway terminates HTTPS at its edge. Never expose the Python loopback port.
:{$PORT:8080} {
  request_body {
    max_size 256KB
  }
  handle /healthz {
    reverse_proxy 127.0.0.1:11521
  }
  handle /api/* {
    reverse_proxy 127.0.0.1:11521
  }
  handle {
    respond "Not found" 404
  }
}
