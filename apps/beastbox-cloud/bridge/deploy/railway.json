{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/beastbox-cloud/bridge/deploy/Dockerfile",
    "watchPatterns": [
      "beastbox/**",
      "apps/beastbox-cloud/bridge/**",
      "pyproject.toml",
      "README.md",
      "LICENSE",
      "apps/beastbox-cloud/lib/rawrphos-public-pin.json",
      "models/rawrphos/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 180,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1,
    "sleepApplication": false
  }
}
