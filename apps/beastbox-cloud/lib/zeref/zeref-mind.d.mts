export type ZerefBehavior='idle'|'blink'|'pounce'|'walk'|'hover'|'curious'|'charge'|'sleep';
export type ZerefReaction='happy'|'startled'|'purr';
export type ZerefProfile={id:string;name?:string;title?:string;tagline?:string;stats?:{energy?:number;signal?:number;memory?:number;resonance?:number};statsSource?:string};
export type ZerefRecordedSource={path:string;alias:string;source_class:string;backend:string;job_id:string;rows:readonly any[]};
export type ZerefSeed={digest:string;runs:number;shots:number;backend:string;job_id:string;features:{zzOdd:number;xxEven:number;lean:number;noise:number}};
export type ZerefExpression={open:number;lower:number;pupil:number;brow:number;smile:number;grin:number;o:number;frown:number;sleepy:number;blush:number;glow:number};
export type ZerefMind={profileId:string;name:string;digest:string;seed:ZerefSeed;traits:Record<string,number>;rng:number;t:number;reduced:boolean;hour:number;energy:number;bond:number;resonance:number;behavior:ZerefBehavior;behaviorStart:number;behaviorEnd:number;reaction:ZerefReaction|null;expr:ZerefExpression;history:string[];[key:string]:any};
export type ZerefFrame={floatX:number;floatY:number;rot:number;face:number;bodySX:number;bodySY:number;headRot:number;headY:number;earL:number;earR:number;wingL:number;wingR:number;tail:number;wisp:number;pawL:number;pawR:number;gazeX:number;gazeY:number;lid:number;lower:number;pupil:number;brow:number;mouth:{smile:number;grin:number;o:number;frown:number;sleepy:number};blush:number;glow:number;ring:number;charge:number;shadow:number;fx:{zzz:number;question:number;exclaim:number;heart:number;sparkle:number}};
export const ZEREF_RECORDED_SOURCE:ZerefRecordedSource;
export const ZEREF_PROFILE:Required<Pick<ZerefProfile,'id'|'name'|'title'|'tagline'|'statsSource'>>&{stats:{energy:number;signal:number;memory:number;resonance:number}};
export const BEHAVIORS:readonly ZerefBehavior[];
export const REACTIONS:readonly ZerefReaction[];
export const LOCOMOTION:readonly ZerefBehavior[];
export function recordedSeed(source?:ZerefRecordedSource):ZerefSeed;
export function nextRandom(m:{rng:number}):number;
export function temperamentFor(profile?:ZerefProfile,seed?:ZerefSeed):Record<string,number>;
export function createMind(options?:{profile?:ZerefProfile;source?:ZerefRecordedSource;care?:{energy?:number;bond?:number};reduced?:boolean;hour?:number}):ZerefMind;
export function behaviorWeights(m:ZerefMind):Record<ZerefBehavior,number>;
export function stepMind(m:ZerefMind,dt:number,inputs?:{hour?:number;pointer?:{x:number;y:number;moved:boolean}}):ZerefMind;
export function tapMind(m:ZerefMind,options?:{hold?:boolean}):ZerefReaction;
export function greetMind(m:ZerefMind):ZerefReaction;
export function describeMind(m:ZerefMind):{behavior:ZerefBehavior;reaction:ZerefReaction|null;state:string;mood:string;line:string;energy:number;bond:number};
export function frameFor(m:ZerefMind):ZerefFrame;
export function forceBehavior(m:ZerefMind,b:ZerefBehavior):ZerefBehavior;
