# Configure these in private Vercel Preview variables; NEVER put credentials in Git.
# If absent, the owner console is inaccessible, and its UI/API stay fail-closed.
BEASTBOX_OWNER_PASSWORD=
BEASTBOX_CLOUD_AUTH_SECRET=
# Requires a separately deployed durable owner-isolated HTTPS bridge implementing
# the existing beastbox/cosmic_web.py API contract and validating Bearer auth.
BEASTBOX_CLOUD_BRIDGE_URL=
BEASTBOX_CLOUD_BRIDGE_TOKEN=
