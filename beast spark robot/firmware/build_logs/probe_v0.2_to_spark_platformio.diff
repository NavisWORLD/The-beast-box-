--- ../reality_bridge_probe_v0.2_original/platformio.ini	2026-11-09 18:03:55.974770614 -0600
+++ platformio.ini	2026-11-09 23:56:44.265019065 -0600
@@ -1,19 +1,55 @@
+; ZEREF SPARK firmware — extends Cory's Reality Bridge Probe v0.2 (copy in ../reality_bridge_probe_v0.2_original).
+; CONCEPT DESIGN / NOT BUILT HARDWARE. Compiles != tested on a board.
 [platformio]
-default_envs = esp32-s3-devkitc-1
+default_envs = zeref-spark
 
-[env:esp32-s3-devkitc-1]
-platform = espressif32 @ 7.0.1
+[env:zeref-spark]
+platform = espressif32 @ 7.0.1          ; same as Cory's original
 board = esp32-s3-devkitc-1
 framework = arduino
 monitor_speed = 115200
 lib_ldf_mode = deep+
 build_flags =
   -DCORE_DEBUG_LEVEL=1
+  -DSPARK_GNSS_WIRED=0      ; GNSS unwired by default (set 1 only after wiring RX17/TX18)
+  -DSPARK_WIFI_AP=0         ; host link is USB; AP off by default (Cory's v0.2 AP had a placeholder password)
+  -DARDUINO_USB_MODE=1      ; DevKitC-1 port labelled "USB" (native USB-Serial/JTAG)
+  -DARDUINO_USB_CDC_ON_BOOT=1  ; Serial = native USB CDC (speech PCM needs ~43 kB/s; a 115200 UART can't carry it)
 lib_deps =
-  bblanchon/ArduinoJson
-  links2004/WebSockets
-  claws/BH1750
-  adafruit/Adafruit BME280 Library
-  adafruit/Adafruit ICM42688
-  sparkfun/SparkFun MAX3010x Pulse and Proximity Sensor Library
+  bblanchon/ArduinoJson @ ^7.4.3
+  claws/BH1750 @ ^1.3.0
+  adafruit/Adafruit BME280 Library @ ^2.3.0
+  ; Cory's original lists "adafruit/Adafruit ICM42688", which does not resolve in the PlatformIO
+  ; registry (checked 2026-11-09). THIRD-PARTY substitute with the same chip:
+  finani/ICM42688 @ 1.1.0
+  sparkfun/SparkFun MAX3010x Pulse and Proximity Sensor Library @ ^1.1.2
   mikalhart/TinyGPSPlus
+  adafruit/Adafruit NeoPixel @ ^1.15.5
+  adafruit/Adafruit AS7341 @ ^1.4.1
+
+; Optional: Wi-Fi AP + WebSocket :81 like Cory's v0.2. Over Wi-Fi the Spark SENDS frames (never raw PPG) and
+; ACCEPTS speech lines only (SAY_BEGIN / PCM / SAY_END / SAY_STOP); UV, SCAN, LED and calibration commands are USB-only.
+; FIX 2026-11-09: lib_ldf_mode = deep (not deep+/chain+). With deep+ the LDF evaluated WebSockets.h's platform #ifs
+; and never added the framework WiFi library to its include path ("WiFi.h: No such file or directory").
+; No password is compiled in: build with  SPARK_AP_PASS='your-8+-char-pass' pio run -e zeref-spark-wifi
+; (empty -> the AP stays off and the Spark says AP_OFF_NO_PASSWORD).
+[env:zeref-spark-wifi]
+extends = env:zeref-spark
+lib_ldf_mode = deep
+build_flags =
+  -DCORE_DEBUG_LEVEL=1
+  -DSPARK_GNSS_WIRED=0
+  -DARDUINO_USB_MODE=1
+  -DARDUINO_USB_CDC_ON_BOOT=1
+  -DSPARK_WIFI_AP=1
+  '-DSPARK_AP_PASS="${sysenv.SPARK_AP_PASS}"'
+lib_deps =
+  ${env:zeref-spark.lib_deps}
+  links2004/WebSockets @ 2.4.1
+
+; Child build (DESIGN_DECISIONS.md D12): same as the USB build, but the UV LED is never driven.
+[env:zeref-spark-kid]
+extends = env:zeref-spark
+build_flags =
+  ${env:zeref-spark.build_flags}
+  -DSPARK_UV_ENABLED=0
